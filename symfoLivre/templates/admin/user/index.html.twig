{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs – symfoLivre{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="fa-solid fa-users-gear me-2"></i>Gestion des utilisateurs</h1>
    <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary">
        <i class="fa-solid fa-user-plus me-1"></i>Nouvel utilisateur
    </a>
</div>

{% if users is empty %}
    <div class="alert alert-info">Aucun utilisateur trouvé.</div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Nom</th>
                    <th>E-mail</th>
                    <th>Rôle</th>
                    <th>Livres</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td class="text-muted">{{ user.id }}</td>
                    <td class="fw-semibold">{{ user.firstname }} {{ user.lastname }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% for role in user.roles %}
                            <span class="badge bg-{{ role == 'ROLE_ADMIN' ? 'danger' : role == 'ROLE_AUTEUR' ? 'primary' : 'secondary' }}">
                                {{ role | replace({'ROLE_': ''}) }}
                            </span>
                        {% endfor %}
                    </td>
                    <td>{{ user.books|length }}</td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}"
                               class="btn btn-sm btn-outline-warning" title="Modifier">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                                {% include 'admin/user/_delete_form.html.twig' %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}