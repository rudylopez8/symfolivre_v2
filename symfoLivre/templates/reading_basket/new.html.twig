{% extends 'base.html.twig' %}

{% block title %}Ajouter au panier – symfoLivre{% endblock %}

{% block body %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_reading_basket_index') }}">Panier</a></li>
        <li class="breadcrumb-item active">Ajouter</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">
                    <i class="fa-solid fa-basket-shopping-plus me-2 text-primary"></i>
                    Ajouter un livre au panier
                </h1>
                {{ form_widget(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}