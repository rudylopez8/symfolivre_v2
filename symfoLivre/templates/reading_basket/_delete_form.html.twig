{% set _id = id|default(basket.id) %}
{% set _label = label|default('Retirer du panier') %}
{% set _btn_class = btn_class|default('btn btn-sm btn-outline-danger') %}

<form method="post" action="{{ path('app_reading_basket_delete', {'id': _id}) }}"
      onsubmit="return confirm('Retirer ce livre du panier de lecture ?');"
      style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ _id) }}">
    <button type="submit" class="{{ _btn_class }}" title="{{ _label }}">
        <i class="fa-solid fa-trash"></i>
    </button>
</form>