{% extends 'base.html.twig' %}

{% block title %}Mon panier de lecture – symfoLivre{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">
        <i class="fa-solid fa-basket-shopping me-2"></i>Mon panier de lecture
        <span class="badge bg-primary ms-2">{{ baskets|length }}</span>
    </h1>
    <a href="{{ path('app_reading_basket_new') }}" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i>Ajouter un livre
    </a>
</div>

{% if baskets is empty %}
    <div class="alert alert-info text-center">
        <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
        Votre panier est vide.<br>
        <a href="{{ path('app_book_index') }}">Parcourez la bibliothèque</a> ou
        <a href="{{ path('app_reading_basket_new') }}">ajoutez un livre</a>.
    </div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Titre</th>
                    <th>Type</th>
                    <th>Auteur</th>
                    <th>Ajouté le</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for basket in baskets %}
                <tr>
                    <td>
                        <a href="{{ path('app_book_show', {'id': basket.book.id}) }}" class="text-decoration-none fw-semibold">
                            {{ basket.book.title }}
                        </a>
                    </td>
                    <td>
                        <span class="badge bg-{{ basket.book.type == 'AUDIO' ? 'warning text-dark' : 'primary' }}">
                            {{ basket.book.type == 'AUDIO' ? 'Audio' : 'Texte' }}
                        </span>
                    </td>
                    <td class="small">
                        {% if basket.book.author %}
                            {{ basket.book.author.firstname }} {{ basket.book.author.lastname }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td class="small text-muted">{{ basket.addedAt | date('d/m/Y H:i') }}</td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            {% if basket.book.type == 'TEXTE' %}
                                <a href="{{ path('app_book_read', {'id': basket.book.id}) }}"
                                   class="btn btn-sm btn-outline-success" title="Lire">
                                    <i class="fa-solid fa-book-open"></i>
                                </a>
                                                {% if baskets is empty %}
                    <div class="alert alert-info text-center">
                        <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                        Votre panier est vide.<br>
                        <a href="{{ path('app_book_index') }}">Parcourez la bibliothèque</a> ou
                        <a href="{{ path('app_reading_basket_new') }}">ajoutez un livre</a>.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Titre</th>
                                    <th>Type</th>
                                    <th>Auteur</th>
                                    <th>Ajouté le</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for basket in baskets %}
                                <tr>
                                    <td>
                                        <a href="{{ path('app_book_show', {'id': basket.book.id}) }}"
                                           class="text-decoration-none fw-semibold">
                                            {{ basket.book.title }}
                                        </a>
                                    </td>
                                    <td>
                                        <span class="badge bg-{{ basket.book.type == 'AUDIO' ? 'warning text-dark' : 'primary' }}">
                                            {{ basket.book.type == 'AUDIO' ? 'Audio' : 'Texte' }}
                                        </span>
                                    </td>
                                    <td class="small">
                                        {% if basket.book.author %}
                                            {{ basket.book.author.firstname }} {{ basket.book.author.lastname }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="small text-muted">{{ basket.addedAt | date('d/m/Y H:i') }}</td>
                                    <td class="text-end">
                                        <div class="btn-group" role="group">
                                            {% if basket.book.type == 'TEXTE' %}
                                                <a href="{{ path('app_book_read', {'id': basket.book.id}) }}"
                                                   class="btn btn-sm btn-outline-success" title="Lire">
                                                    <i class="fa-solid fa-book-open"></i>
                                                </a>
                                            {% endif %}
                                            <a href="{{ path('app_book_download', {'id': basket.book.id}) }}"
                                               class="btn btn-sm btn-outline-primary" title="Télécharger">
                                                <i class="fa-solid fa-download"></i>
                                            </a>
                                            {% include 'reading_basket/_delete_form.html.twig' with {
                                                'id': basket.id,
                                                'label': 'Retirer du panier'
                                            } %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
{% endblock %}