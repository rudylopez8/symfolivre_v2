{% extends 'base.html.twig' %}

{% block title %}Lecture : {{ book.title }} – symfoLivre{% endblock %}

{% block stylesheets %}
<style>
    .reader-container {
        background: #fffdf5;
        border: 1px solid #e0d8c0;
        border-radius: .5rem;
        padding: 2rem;
        line-height: 1.85;
        font-size: 1.05rem;
        max-height: 75vh;
        overflow-y: auto;
        box-shadow: inset 0 0 20px rgba(0,0,0,.03);
    }
</style>
{% endblock %}

{% block body %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_book_index') }}">Bibliothèque</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_book_show', {'id': book.id}) }}">{{ book.title }}</a></li>
        <li class="breadcrumb-item active">Lecture</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">
        <i class="fa-solid fa-book-open text-primary me-2"></i>{{ book.title }}
    </h1>
    <a href="{{ path('app_book_download', {'id': book.id}) }}" class="btn btn-sm btn-outline-primary">
        <i class="fa-solid fa-download me-1"></i>Télécharger
    </a>
</div>

<div class="reader-container">
    <pre class="read-content m-0">{{ content }}</pre>
</div>
{% endblock %}