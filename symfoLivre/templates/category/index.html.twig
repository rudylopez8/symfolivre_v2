{% extends 'base.html.twig' %}

{% block title %}Catégories – symfoLivre{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="fa-solid fa-folder-open me-2"></i>Catégories</h1>
    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_category_new') }}" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i>Nouvelle catégorie
        </a>
    {% endif %}
</div>

{% if categories is empty %}
    <div class="alert alert-info">Aucune catégorie n'a encore été créée.</div>
{% else %}
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for category in categories %}
                <tr>
                    <td class="text-muted">{{ loop.index }}</td>
                    <td>
                        <a href="{{ path('app_category_show', {'id': category.id}) }}" class="text-decoration-none fw-semibold">
                            {{ category.label }}
                        </a>
                    </td>
                    <td class="text-muted small">{{ category.description ? category.description | slice(0, 80) ~ (category.description|length > 80 ? '…' : '') : '—' }}</td>
                    <td class="text-end">
                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_category_edit', {'id': category.id}) }}"
                                   class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                {% include 'category/_delete_form.html.twig' %}
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
{% endblock %}