{% set _btn_class = btn_class|default('btn btn-sm btn-outline-danger') %}
<form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}"
      onsubmit="return confirm('Supprimer la catégorie « {{ category.label }} » ? Les livres seront déplacés en « Sans catégorie ».');"
      style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    <button type="submit" class="{{ _btn_class }}" title="Supprimer">
        <i class="fa-solid fa-trash"></i>
    </button>
</form>