<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}symfoLivre{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        /* ═══════════ Charte graphique symfoLivre ═══════════ */
        :root {
            --bs-primary: #1a365d;
            --bs-primary-rgb: 26, 54, 93;
            --bs-primary-text-emphasis: #1a365d;
            --bs-link-color: #1a365d;
            --bs-link-hover-color: #16294a;
            --accent: #d69e2e;
            --accent-hover: #b9820f;
            --bg-app: #f7fafc;
            --radius-sm: 8px;
            --radius-md: 12px;
            --shadow-sm: 0 1px 3px rgba(26, 54, 93, .08);
            --shadow-md: 0 4px 12px rgba(26, 54, 93, .12);
            --shadow-lg: 0 10px 28px rgba(26, 54, 93, .16);
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-app);
        }
        main { flex: 1; }

        .navbar-brand { font-weight: 700; letter-spacing: .5px; }

        /* Cartes / conteneurs : rayons et ombres de la charte */
        .card, .book-card {
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            border: none;
            transition: transform .15s, box-shadow .15s;
        }
        .book-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

        .btn { border-radius: var(--radius-sm); }

        /* Bouton d'accent (CTA type "S'inscrire") — couleur or/ambre de la charte */
        .btn-accent {
            background-color: var(--accent);
            border-color: var(--accent);
            color: #1a1a1a;
            font-weight: 600;
        }
        .btn-accent:hover, .btn-accent:focus {
            background-color: var(--accent-hover);
            border-color: var(--accent-hover);
            color: #1a1a1a;
        }

        pre.read-content { white-space: pre-wrap; word-wrap: break-word; max-height: 80vh; overflow-y: auto; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<!-- ═══════════ NAVBAR ═══════════ -->
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <i class="fa-solid fa-book-open me-2"></i>symfoLivre
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navMenu"
                aria-controls="navMenu" aria-expanded="false"
                aria-label="Basculer l'affichage du menu de navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_book_index') }}">
                        <i class="fa-solid fa-list me-1"></i>Bibliothèque
                    </a>
                </li>
                {% if is_granted('ROLE_USER') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_reading_basket_index') }}">
                        <i class="fa-solid fa-basket-shopping me-1"></i>Mon panier
                    </a>
                </li>
                {% endif %}
                {% if is_granted('ROLE_AUTEUR') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_book_new') }}">
                        <i class="fa-solid fa-plus me-1"></i>Ajouter un livre
                    </a>
                </li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_category_index') }}">
                        <i class="fa-solid fa-folder me-1"></i>Catégories
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_admin_user_index') }}">
                        <i class="fa-solid fa-users-gear me-1"></i>Utilisateurs
                    </a>
                </li>
                {% endif %}
            </ul>

            <ul class="navbar-nav ms-auto">
                {% if app.user %}
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle btn btn-link" type="button"
                                id="userMenuToggle" data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Ouvrir le menu du compte de {{ app.user.firstname }} {{ app.user.lastname }}">
                            <i class="fa-solid fa-user me-1"></i>
                            {{ app.user.firstname }} {{ app.user.lastname }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuToggle">
                            <li>
                                <span class="dropdown-item-text text-muted small">
                                    Rôle :
                                    {% for role in app.user.roles %}
                                        <span class="badge bg-{{ role == 'ROLE_ADMIN' ? 'danger' : role == 'ROLE_AUTEUR' ? 'primary' : 'secondary' }}">
                                            {{ role | replace({'ROLE_': ''}) }}
                                        </span>
                                    {% endfor %}
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_profile') }}">
                                    <i class="fa-solid fa-id-card me-1"></i>Mon profil
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    <i class="fa-solid fa-sign-out-alt me-1"></i>Déconnexion
                                </a>
                            </li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">
                            <i class="fa-solid fa-sign-in me-1"></i>Connexion
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-accent btn-sm ms-lg-2 mt-1 mt-lg-0" href="{{ path('app_register') }}">
                            S'inscrire
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

<!-- ═══════════ FLASH MESSAGES ═══════════ -->
<div class="container mb-3">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer ce message"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<!-- ═══════════ CONTENT ═══════════ -->
<main class="container mb-5">
    {% block body %}{% endblock %}
</main>

<!-- ═══════════ FOOTER ═══════════ -->
<footer class="bg-primary text-light py-3 mt-auto">
    <div class="container text-center">
        <small>symfoLivre &copy; {{ "now" | date("Y") }} &mdash; Gestion de bibliothèque numérique</small>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>